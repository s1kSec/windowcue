<?xml version="1.0" encoding="utf-8"?>
<!-- Template only. Build-Msix.ps1 requires real Partner Center values in Store mode. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__"
            Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Description>__DESCRIPTION__</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="__LANGUAGE__" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="__SDK_VERSION__" />
  </Dependencies>
  <Applications>
    <Application Id="WindowCue" Executable="app\WindowCue.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="__DISPLAY_NAME__" Description="__DESCRIPTION__"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="app\WindowCue.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="WindowCueStartup" Enabled="false"
                               DisplayName="__DISPLAY_NAME__" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

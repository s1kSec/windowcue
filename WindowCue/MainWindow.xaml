<Window x:Class="WindowCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowCue"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{x:Static local:Strings.AppTitle}"
        Icon="Assets/WindowCue.ico"
        Width="1080"
        MinWidth="760"
        MinHeight="310"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Foreground="White"
        StateChanged="MainWindow_OnStateChanged">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D7D9DE"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*" MinHeight="193"/>
            <RowDefinition Height="Auto" MinHeight="82"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource WindowBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/WindowCue.ico" Width="18" Height="18"/>
                <TextBlock Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#D7D9DE"
                           Text="{x:Static local:Strings.AppTitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource CaptionButton}" Content="—" Click="MinimizeButton_OnClick"/>
            <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Content="□" Click="MaximizeButton_OnClick"/>
            <Button Grid.Column="3" Style="{StaticResource CaptionButton}" Content="×" Click="CloseButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="1" Margin="12,7,12,8">
            <Border Background="#1B1C20" BorderBrush="#303238" BorderThickness="1" CornerRadius="12"/>
            <ScrollViewer x:Name="PreviewScroll"
                          Margin="7"
                          Padding="2"
                          MinHeight="164"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <WrapPanel x:Name="WindowPanel" Orientation="Horizontal"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText"
                       Text="{x:Static local:Strings.NoWindows}"
                       Foreground="{StaticResource MutedText}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="BindingPanel"
                Grid.Row="2"
                Margin="12,0,12,12"
                Padding="15"
                MinHeight="70"
                Background="{StaticResource PanelBackground}"
                BorderBrush="#3B3D44"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="SelectedIcon" Width="26" Height="26" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0,15,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedTitle"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedText}"
                               Text="{x:Static local:Strings.SelectWindowFirst}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SelectedProcess"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource MutedText}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBox x:Name="HotkeyBox"
                         Grid.Column="2"
                         Height="38"
                         Margin="0,0,10,0"
                         Padding="12,8"
                         IsReadOnly="True"
                         FontSize="14"
                         HorizontalContentAlignment="Center"
                         ToolTip="{x:Static local:Strings.HotkeyTooltip}"
                         IsEnabled="False"
                         PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_OnGotKeyboardFocus"
                         LostKeyboardFocus="HotkeyBox_OnLostKeyboardFocus"/>

                <Button x:Name="BindingActionButton"
                        Grid.Column="3"
                        Content="{x:Static local:Strings.Bind}"
                        Background="#7550A0"
                        BorderBrush="#B47DE8"
                        IsEnabled="False"
                        Click="BindButton_OnClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>

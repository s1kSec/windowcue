<Application x:Class="WindowCue.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#151619"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#202126"/>
        <SolidColorBrush x:Key="CardBackground" Color="#101114"/>
        <SolidColorBrush x:Key="MutedText" Color="#9A9DA6"/>
        <SolidColorBrush x:Key="Accent" Color="#C88BFF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#303238"/>
            <Setter Property="BorderBrush" Value="#454850"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111216"/>
            <Setter Property="BorderBrush" Value="#50535B"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Application.Resources>
</Application>
